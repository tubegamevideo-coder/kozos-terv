# --- Docker Compose (otthoni szerver) ---
POSTGRES_PASSWORD=valtoztasd-meg-hosszu-veletlen-jelszo
# Helyi elérés: 127.0.0.1 (csak a szerverről) vagy a szerver Tailscale-címe.
APP_BIND=127.0.0.1
APP_PORT=3100

# --- Nyilvános cím (Cloudflare Tunnel) ---
# A „public” profil indítja a cloudflared konténert.
COMPOSE_PROFILES=public
ORIGIN=https://terv.nebulooo.com
CLOUDFLARE_TUNNEL_TOKEN=

# --- Belépés ---
# oauth: Google-belépés a weben, OAuth 2.1 a Claude-nak (éles).
# dev:   statikus MCP-tokenek (MCP_DEV_TOKENS), csak http-s ORIGIN mellett, helyi teszteléshez.
AUTH_MODE=oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MCP_DEV_TOKENS=token=email,token2=email2

# Kezdőadatok (seed): Név=email párok; az első a tulajdonos. A Google-fiókok címei legyenek.
SEED_USERS=

# --- Helyi fejlesztés (docker compose -f docker-compose.dev.yml) ---
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kozos_terv
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kozos_terv_test
