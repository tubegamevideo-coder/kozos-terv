# --- Docker Compose (otthoni szerver) ---
POSTGRES_PASSWORD=valtoztasd-meg-hosszu-veletlen-jelszo
# Hol hallgasson az app a gazdagépen: 127.0.0.1 (csak helyben) vagy a szerver Tailscale-címe.
APP_BIND=127.0.0.1
APP_PORT=3100
ORIGIN=http://localhost:3100

# --- MCP-belépés ---
# 2. lépés: fejlesztői tokenek (openssl rand -hex 24), token=email párok vesszővel.
# Csak helyi / Tailscale-elérésnél! Nyilvános címen az OAuth kell (3. lépés).
AUTH_MODE=dev
MCP_DEV_TOKENS=

# Kezdőadatok (npm run seed:dev): Név=email párok; az első a tulajdonos.
SEED_USERS=

# --- Helyi fejlesztés (docker compose -f docker-compose.dev.yml) ---
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kozos_terv
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kozos_terv_test

# --- 3. lépéstől: Google-belépés és OAuth ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# CLOUDFLARE_TUNNEL_TOKEN=
