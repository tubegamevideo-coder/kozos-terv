{
	"name": "kozos-terv",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --import tsx scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"seed:dev": "node --import tsx scripts/seed-dev.ts",
		"start": "node build"
	},
	"devDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@sveltejs/adapter-node": "^6.0.2",
		"diff": "^9.0.0",
		"drizzle-orm": "^0.45.4",
		"marked": "^18.2.0",
		"mermaid": "^12.3.0",
		"postgres": "^4.1.0",
		"sanitize-html": "^2.18.1",
		"tsx": "^4.23.15",
		"zod": "^4.6.7"
	}
}
